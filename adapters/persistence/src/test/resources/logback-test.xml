<!--
  The persistence tests read ValkeyFailures' log as Logback events. Without this file Logback would
  print every library's DEBUG lines (Lettuce, Netty, Testcontainers) into the test reports.
-->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
