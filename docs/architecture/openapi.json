{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Searches the flights aggregated from every provider and re-prices a chosen itinerary live, both public and rate-limited per client address; with a token holding the ADMIN role, reads the inventory's and each provider's status and starts an ingestion.",
    "title" : "Flight aggregator API",
    "version" : "1.0.0"
  },
  "servers" : [
    {
      "url" : "/",
      "description" : "The host serving this contract"
    }
  ],
  "paths" : {
    "/api/admin/ingestions" : {
      "post" : {
        "operationId" : "runIngestion",
        "responses" : {
          "202" : {
            "description" : "A run started; it goes on in the background"
          },
          "401" : {
            "description" : "No valid bearer token"
          },
          "403" : {
            "description" : "The token does not hold the ADMIN role"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Another run is going on; try again once it ends"
          }
        },
        "security" : [
          {
            "bearer" : [ ]
          }
        ],
        "tags" : [
          "admin-controller"
        ]
      }
    },
    "/api/admin/status" : {
      "get" : {
        "operationId" : "status",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StatusResponse"
                }
              }
            },
            "description" : "The inventory's and each provider's status"
          },
          "401" : {
            "description" : "No valid bearer token"
          },
          "403" : {
            "description" : "The token does not hold the ADMIN role"
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The inventory could not be read in time; try again after Retry-After",
            "headers" : {
              "Retry-After" : {
                "description" : "How many seconds to wait before asking again",
                "required" : true,
                "schema" : {
                  "type" : "integer",
                  "minimum" : 0
                },
                "style" : "simple"
              }
            }
          }
        },
        "security" : [
          {
            "bearer" : [ ]
          }
        ],
        "tags" : [
          "admin-controller"
        ]
      }
    },
    "/api/itineraries" : {
      "get" : {
        "operationId" : "search",
        "parameters" : [
          {
            "description" : "The airport the trip departs from: a three-letter code, in any case",
            "in" : "query",
            "name" : "origin",
            "required" : false,
            "schema" : {
              "type" : "string",
              "pattern" : "^[A-Za-z]{3}$"
            }
          },
          {
            "description" : "The airport the trip arrives at: a three-letter code, in any case",
            "in" : "query",
            "name" : "destination",
            "required" : false,
            "schema" : {
              "type" : "string",
              "pattern" : "^[A-Za-z]{3}$"
            }
          },
          {
            "description" : "The highest final price in euros, inclusive, above 0",
            "in" : "query",
            "name" : "maxPrice",
            "required" : false,
            "schema" : {
              "type" : "string",
              "pattern" : "^(?!0+(\\.0{1,2})?$)[0-9]{1,9}(\\.[0-9]{1,2})?$"
            }
          },
          {
            "description" : "The airline that operates every leg: a two-character code, in any case",
            "in" : "query",
            "name" : "carrier",
            "required" : false,
            "schema" : {
              "type" : "string",
              "pattern" : "^[A-Za-z0-9]{2}$"
            }
          },
          {
            "description" : "The order of the results",
            "in" : "query",
            "name" : "sort",
            "required" : false,
            "schema" : {
              "type" : "string",
              "default" : "price",
              "enum" : [
                "price",
                "departure",
                "duration"
              ]
            }
          },
          {
            "description" : "How many itineraries the page holds at most",
            "in" : "query",
            "name" : "limit",
            "required" : false,
            "schema" : {
              "type" : "integer",
              "format" : "int32",
              "default" : 20,
              "maximum" : 100,
              "minimum" : 1
            }
          },
          {
            "description" : "The previous page's nextCursor, to read the page after it",
            "in" : "query",
            "name" : "cursor",
            "required" : false,
            "schema" : {
              "type" : "string",
              "maxLength" : 200
            }
          }
        ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SearchResponse"
                }
              }
            },
            "description" : "One page of itineraries"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "A parameter or the cursor is not valid; the detail names it"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Too many searches from this address; try again after Retry-After",
            "headers" : {
              "Retry-After" : {
                "description" : "How many seconds to wait before asking again",
                "required" : true,
                "schema" : {
                  "type" : "integer",
                  "minimum" : 0
                },
                "style" : "simple"
              }
            }
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The search took too long to read; try again after Retry-After",
            "headers" : {
              "Retry-After" : {
                "description" : "How many seconds to wait before asking again",
                "required" : true,
                "schema" : {
                  "type" : "integer",
                  "minimum" : 0
                },
                "style" : "simple"
              }
            }
          }
        },
        "tags" : [
          "search-controller"
        ]
      }
    },
    "/api/itineraries/{id}/reprice" : {
      "post" : {
        "operationId" : "reprice",
        "parameters" : [
          {
            "description" : "The id of the chosen itinerary, as the search gave it",
            "in" : "path",
            "name" : "id",
            "required" : true,
            "schema" : {
              "type" : "string",
              "format" : "uuid",
              "pattern" : "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          }
        ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RepriceResponse"
                }
              }
            },
            "description" : "The choice confirmed, at its price or a new one, or the best alternative"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The id is not an itinerary id"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No itinerary with this id is on sale; search again"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Too many re-prices from this address; try again after Retry-After",
            "headers" : {
              "Retry-After" : {
                "description" : "How many seconds to wait before asking again",
                "required" : true,
                "schema" : {
                  "type" : "integer",
                  "minimum" : 0
                },
                "style" : "simple"
              }
            }
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Nothing could be confirmed, or the flights could not be read in time; try again after Retry-After",
            "headers" : {
              "Retry-After" : {
                "description" : "How many seconds to wait before asking again",
                "required" : true,
                "schema" : {
                  "type" : "integer",
                  "minimum" : 0
                },
                "style" : "simple"
              }
            }
          }
        },
        "tags" : [
          "reprice-controller"
        ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ItineraryResponse" : {
        "type" : "object",
        "properties" : {
          "arrival" : {
            "type" : "string",
            "format" : "date-time"
          },
          "departure" : {
            "type" : "string",
            "format" : "date-time"
          },
          "destination" : {
            "type" : "string"
          },
          "durationMinutes" : {
            "type" : "integer",
            "format" : "int64"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "legs" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Leg"
            }
          },
          "origin" : {
            "type" : "string"
          },
          "price" : {
            "$ref" : "#/components/schemas/Price"
          },
          "quotedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "stops" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [
          "arrival",
          "departure",
          "destination",
          "durationMinutes",
          "id",
          "legs",
          "origin",
          "price",
          "quotedAt",
          "stops"
        ]
      },
      "Leg" : {
        "type" : "object",
        "properties" : {
          "arrival" : {
            "type" : "string",
            "format" : "date-time"
          },
          "carrier" : {
            "type" : "string"
          },
          "departure" : {
            "type" : "string",
            "format" : "date-time"
          },
          "destination" : {
            "type" : "string"
          },
          "flightNumber" : {
            "type" : "integer",
            "format" : "int32"
          },
          "origin" : {
            "type" : "string"
          }
        },
        "required" : [
          "arrival",
          "carrier",
          "departure",
          "destination",
          "flightNumber",
          "origin"
        ]
      },
      "Price" : {
        "type" : "object",
        "properties" : {
          "amount" : {
            "type" : "string"
          },
          "currency" : {
            "type" : "string"
          }
        },
        "required" : [
          "amount",
          "currency"
        ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "description" : "An RFC 9457 problem: what went wrong with the request",
        "properties" : {
          "detail" : {
            "type" : "string",
            "description" : "What went wrong and what to do, naming the parameter at fault"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri-reference",
            "description" : "The path of the request, such as /api/itineraries"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "The HTTP status code"
          },
          "title" : {
            "type" : "string",
            "description" : "The status's reason phrase, such as \"Bad Request\""
          }
        },
        "required" : [
          "detail",
          "instance",
          "status",
          "title"
        ]
      },
      "ProviderStatusResponse" : {
        "type" : "object",
        "properties" : {
          "breaker" : {
            "type" : "string",
            "enum" : [
              "CLOSED",
              "OPEN",
              "HALF_OPEN"
            ]
          },
          "discarded" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "integer",
              "format" : "int32"
            }
          },
          "health" : {
            "type" : "string",
            "enum" : [
              "UP",
              "DEGRADED",
              "DOWN"
            ]
          },
          "legs" : {
            "type" : "integer",
            "format" : "int32"
          },
          "newestQuotedAt" : {
            "type" : [
              "string",
              "null"
            ],
            "format" : "date-time"
          },
          "provider" : {
            "type" : "string",
            "enum" : [
              "ALPHA",
              "BETA",
              "GAMMA"
            ]
          },
          "stale" : {
            "type" : "boolean"
          }
        },
        "required" : [
          "breaker",
          "discarded",
          "health",
          "legs",
          "newestQuotedAt",
          "provider",
          "stale"
        ]
      },
      "RepriceResponse" : {
        "type" : "object",
        "properties" : {
          "itinerary" : {
            "$ref" : "#/components/schemas/ItineraryResponse"
          },
          "notice" : {
            "type" : "string",
            "description" : "Why another itinerary is offered; only with ALTERNATIVE"
          },
          "outcome" : {
            "type" : "string",
            "enum" : [
              "CONFIRMED",
              "PRICE_CHANGED",
              "ALTERNATIVE"
            ]
          },
          "previousPrice" : {
            "$ref" : "#/components/schemas/Price",
            "description" : "The price shown before; only with PRICE_CHANGED"
          }
        },
        "required" : [
          "itinerary",
          "outcome"
        ]
      },
      "SearchResponse" : {
        "type" : "object",
        "properties" : {
          "inventoryChanged" : {
            "type" : "boolean"
          },
          "itineraries" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ItineraryResponse"
            }
          },
          "nextCursor" : {
            "type" : [
              "string",
              "null"
            ]
          }
        },
        "required" : [
          "inventoryChanged",
          "itineraries",
          "nextCursor"
        ]
      },
      "StatusResponse" : {
        "type" : "object",
        "properties" : {
          "generation" : {
            "type" : "integer",
            "format" : "int64"
          },
          "nextIngestionAt" : {
            "type" : [
              "string",
              "null"
            ],
            "format" : "date-time"
          },
          "providers" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ProviderStatusResponse"
            }
          },
          "publishedAt" : {
            "type" : [
              "string",
              "null"
            ],
            "format" : "date-time"
          }
        },
        "required" : [
          "generation",
          "nextIngestionAt",
          "providers",
          "publishedAt"
        ]
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
