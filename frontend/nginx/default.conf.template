# Rendered at container start by the nginx image's entrypoint: ${API_UPSTREAM}, ${OIDC_AUTHORITY},
# ${OIDC_CLIENT_ID} and ${NGINX_LOCAL_RESOLVERS} come from the environment; nginx's own variables
# ($uri, $remote_addr) are not environment variables, so the rendering leaves them alone.

# The container's own nameservers, from /etc/resolv.conf (the image's 15-local-resolvers.envsh,
# turned on in the Dockerfile): Docker's embedded DNS (127.0.0.11) in compose, the cluster's DNS
# elsewhere. With the upstream in a variable, nginx resolves it per request, so a recreated app
# container (a new address) is found without restarting nginx.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

server {
    listen 8080;
    # "localhost" resolves to ::1 first in the image, which is what the health check connects to.
    listen [::]:8080;
    root /usr/share/nginx/html;

    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        # Overwritten, never appended: the app's rate limit counts the client address, which a client
        # must not be able to choose through a header it sends itself.
        proxy_set_header X-Forwarded-For $remote_addr;
        # The app also takes the scheme, host and port from these (RemoteIpValve): a client must not
        # set them either. An empty value is not sent.
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header Host $host;
        # An app that accepts the call and never answers gets a 504 after 20 s, rather than after
        # nginx's 60 s (and three retries of the search). 20 s is above the slowest re-price: no
        # quote starts after its 10 s budget, but one already started can take its provider's three
        # attempts of 2.5 s (17.5 s in all), so a shorter limit could cut a re-price the app then
        # completes and stores.
        proxy_read_timeout 20s;
        proxy_pass $api_upstream;
    }

    # The dashboard's settings, read by the admin screen before it signs in.
    location = /config.json {
        default_type application/json;
        return 200 '{"oidcAuthority":"${OIDC_AUTHORITY}","oidcClientId":"${OIDC_CLIENT_ID}"}';
    }

    # The bundle's own files: one that does not exist (asked for by an index.html from before a
    # redeploy) is a 404, not index.html served as a script.
    location /assets/ {
        try_files $uri =404;
    }

    # /admin and shared search URLs are routes of the app, not files: they survive a reload.
    location / {
        try_files $uri /index.html;
    }
}
