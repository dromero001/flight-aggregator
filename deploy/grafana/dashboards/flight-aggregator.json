{
  "uid": "flight-aggregator",
  "title": "Flight aggregator",
  "description": "Every metric the spec promises (spec 6.10). Instances are combined as the alert rules combine them: max of failures and partition gauges, min of freshness.",
  "editable": false,
  "schemaVersion": 41,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Provider calls",
      "description": "Calls to each provider per second, by outcome (spec 6.5).",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (provider, outcome) (rate(provider_calls_total[$__rate_interval]))",
          "legendFormat": "{{provider}} {{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Circuit breakers",
      "description": "Each provider's circuit breaker state (spec 6.5). An instance whose breaker is in another state shows a second tile for that provider.",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "textMode": "name",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*: closed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*: half_open" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*: (open|forced_open)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (name, state) (resilience4j_circuitbreaker_state) == 1",
          "legendFormat": "{{name}}: {{state}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Data freshness",
      "description": "Age of each provider's newest data, the youngest over the instances (spec 6.5). Red from 90 minutes, when ProviderDataStale fires. Unknown, in red, when no instance holds a number for it (NaN until an instance's first run, or no instance scraped), which ProviderDataStale counts as stale and fires on after 15 minutes.",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "unknown",
          "mappings": [
            { "type": "special", "options": { "match": "null+nan", "result": { "text": "unknown", "color": "red" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 5400 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "min by (provider) (ingestion_provider_last_fresh_seconds)",
          "legendFormat": "{{provider}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ingestion",
      "description": "Runs in the last hour by outcome and failed runs in a row (max over the instances) on the right axis; each run's duration on the left axis, against the 30-minute cadence (spec 6.4, 6.5). A counter first seen within the hour counts in full.",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": { "axisPlacement": "right" }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.axisPlacement", "value": "left" },
              { "id": "custom.axisSoftMax", "value": 1800 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "transparent", "value": null },
                    { "color": "red", "value": 1800 }
                  ]
                }
              },
              { "id": "custom.thresholdsStyle", "value": { "mode": "line" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome) ((ingestion_runs_total unless ingestion_runs_total offset 1h) or increase(ingestion_runs_total[1h]))",
          "legendFormat": "Runs {{outcome}} (last hour)"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (outcome) (ingestion_duration_seconds_max)",
          "legendFormat": "Duration {{outcome}}"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(ingestion_consecutive_failures)",
          "legendFormat": "Failed runs in a row"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "Hits over all lookups of the search cache in the last hour, errors included: an error is served from PostgreSQL like a miss (spec 6.2).",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(search_cache_total{result=\"hit\"}[1h])) / sum(increase(search_cache_total[1h]))",
          "legendFormat": "Hit ratio (last hour)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Discarded records",
      "description": "Provider records discarded in the last hour, by provider and reason (spec 6.7). A counter first seen within the hour counts in full.",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (provider, reason) ((ingestion_records_discarded_total unless ingestion_records_discarded_total offset 1h) or increase(ingestion_records_discarded_total[1h]))",
          "legendFormat": "{{provider}} {{reason}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Partitions",
      "description": "Days of daily partitions created ahead and rows in the DEFAULT partition, max over the instances (spec 4.3). Red as their alerts fire: below 34 days, above 0 rows. Unknown when no instance holds a number (NaN until an instance's first run, or no instance scraped): red, since PartitionHorizonShort counts it as short and fires on it after 15 minutes; orange for the rows, whose unknown is that same alert's.",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "noValue": "unknown",
          "mappings": [
            { "type": "special", "options": { "match": "null+nan", "result": { "text": "unknown", "color": "red" } } }
          ]
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "green", "value": 34 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "special", "options": { "match": "null+nan", "result": { "text": "unknown", "color": "orange" } } }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "red", "value": 1 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(ingestion_partitions_days_ahead)",
          "legendFormat": "Days ahead",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(ingestion_partitions_default_rows)",
          "legendFormat": "Rows in DEFAULT",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Logs",
      "description": "The application's log lines from Loki, newest first. Click a line for its details: its level, its key-value pairs, and View trace, which opens the line's trace in Tempo.",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=\"flight-aggregator\"}"
        }
      ]
    }
  ]
}
