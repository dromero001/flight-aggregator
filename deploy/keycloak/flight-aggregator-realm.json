{
  "realm": "flight-aggregator",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administers the flight aggregator: admin endpoints and Actuator"
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.com",
      "firstName": "Demo",
      "lastName": "Admin",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo-admin-password",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "service-account-admin-service",
      "enabled": true,
      "serviceAccountClientId": "admin-service",
      "realmRoles": ["ADMIN"]
    }
  ],
  "clients": [
    {
      "clientId": "admin-service",
      "name": "Admin service (machine access)",
      "description": "Confidential client for scripts and tools: client_credentials grant, its service account holds ADMIN",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ADMIN_SERVICE_CLIENT_SECRET:demo-admin-service-secret}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "dashboard",
      "name": "Dashboard (browser sign-in)",
      "description": "Public client for the dashboard's admin screen: Authorization Code with PKCE S256, no secret, no password grant",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/admin*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ]
}
